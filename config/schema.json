{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "speech-rate SG0 config",
  "type": "object",
  "required": [
    "paths",
    "dataset",
    "events",
    "evoked_trf",
    "induced_trf",
    "ddc",
    "reporting"
  ],
  "properties": {
    "paths": {
      "type": "object",
      "required": [
        "out_dir"
      ],
      "properties": {
        "out_dir": {
          "type": "string",
          "minLength": 1
        },
        "bids_dir": {
          "type": "string",
          "minLength": 1
        },
        "eeg_dir": {
          "type": "string",
          "minLength": 1
        },
        "annotations_dir": {
          "type": "string",
          "minLength": 1
        },
        "logs_dir": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "dataset": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        },
        "missing_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dyad_id",
              "run"
            ],
            "properties": {
              "dyad_id": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              },
              "run": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "exclude_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dyad_id",
              "run",
              "reason"
            ],
            "properties": {
              "dyad_id": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              },
              "run": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "exclude": {
          "type": "object",
          "properties": {
            "subjects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "subject_id",
                  "reason"
                ],
                "properties": {
                  "subject_id": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "subject_runs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "subject_id",
                  "run",
                  "reason"
                ],
                "properties": {
                  "subject_id": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "run": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "dyads": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "dyad_id",
                  "reason"
                ],
                "properties": {
                  "dyad_id": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "dyad_runs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "dyad_id",
                  "run",
                  "reason"
                ],
                "properties": {
                  "dyad_id": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "run": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "events": {
      "type": "object",
      "properties": {
        "ipu_min_duration_s": {
          "type": "number",
          "minimum": 0
        },
        "ipu_min_syllables": {
          "type": "integer",
          "minimum": 0
        },
        "time_within_run": {
          "type": "object",
          "properties": {
            "normalize": {
              "type": "boolean"
            },
            "method": {
              "type": "string",
              "enum": [
                "run_duration",
                "minmax_0_1"
              ]
            }
          },
          "additionalProperties": true
        },
        "matching": {
          "type": "object",
          "properties": {
            "absdiff_window_s": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "evoked_trf": {
      "type": "object",
      "properties": {
        "downsample_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lags_s": {
          "type": "object",
          "properties": {
            "tmin": {
              "type": "number"
            },
            "tmax": {
              "type": "number"
            }
          },
          "additionalProperties": true
        },
        "emg": {
          "type": "object",
          "properties": {
            "channels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "channel_patterns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "missing_policy": {
              "type": "string",
              "enum": [
                "error",
                "zeros"
              ]
            },
            "l_freq": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h_freq": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "log_transform": {
              "type": "boolean"
            },
            "target_sfreq": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "zscore_within_run": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "regularization": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ridge",
                "laplacian"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "induced_trf": {
      "type": "object"
    },
    "fooof": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "window_length_s": {
              "type": "number"
            },
            "window_alignment": {
              "type": "string"
            },
            "freq_range": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "peak_threshold": {
              "type": "number"
            },
            "max_n_peaks": {
              "type": "integer"
            },
            "bands": {
              "type": "object"
            },
            "rois": {
              "type": "object"
            }
          },
          "required": [
            "window_length_s",
            "window_alignment",
            "freq_range",
            "peak_threshold",
            "max_n_peaks",
            "bands",
            "rois"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "prespeech_window_s": {
              "type": "object",
              "required": [
                "tmin",
                "tmax"
              ],
              "properties": {
                "tmin": {
                  "type": "number"
                },
                "tmax": {
                  "type": "number"
                }
              },
              "additionalProperties": true
            },
            "rois": {
              "type": "object"
            },
            "spectrum": {
              "type": "object"
            },
            "model": {
              "type": "object"
            },
            "features": {
              "type": "object"
            },
            "qc": {
              "type": "object"
            },
            "standardization": {
              "type": "object"
            },
            "pca": {
              "type": "object"
            },
            "lmm": {
              "type": "object"
            }
          },
          "required": [
            "prespeech_window_s",
            "rois",
            "spectrum",
            "model",
            "features"
          ],
          "additionalProperties": true
        }
      ]
    },
    "ddc": {
      "type": "object"
    },
    "reporting": {
      "type": "object"
    },
    "random_seed": {
      "type": "integer"
    }
  },
  "additionalProperties": true
}
