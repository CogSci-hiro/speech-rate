{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "speech-rate mass-univariate config",
  "type": "object",
  "required": ["paths", "dataset", "preprocessing", "epochs", "glm", "lmeeeg"],
  "properties": {
    "paths": {
      "type": "object",
      "required": ["out_dir", "ica_dir"],
      "properties": {
        "out_dir": {"type": "string", "minLength": 1},
        "bids_dir": {"type": "string", "minLength": 1},
        "ica_dir": {"type": "string", "minLength": 1},
        "annotations_dir": {"type": "string", "minLength": 1},
        "logs_dir": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "dataset": {
      "type": "object",
      "properties": {
        "tasks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "runs": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "integer"},
              {"type": "string", "minLength": 1}
            ]
          }
        },
        "missing_runs": {"type": "array"},
        "exclude": {"type": "object"}
      },
      "additionalProperties": true
    },
    "preprocessing": {"type": "object"},
    "epochs": {"type": "object"},
    "glm": {"type": "object"},
    "lmeeeg": {"type": "object"},
    "lmeeeg_variance_partition": {"type": "object"},
    "similarity": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "analysis_name": {"type": "string", "minLength": 1},
        "predictor_a": {"type": "string", "minLength": 1},
        "predictor_b": {"type": "string", "minLength": 1},
        "map_type": {"type": "string", "enum": ["beta", "t_value"]},
        "input": {
          "type": "object",
          "properties": {
            "domain": {"type": "string", "minLength": 1},
            "result_kind": {"type": "string", "minLength": 1},
            "predictor_a": {"type": "string", "minLength": 1},
            "predictor_b": {"type": "string", "minLength": 1},
            "value_field": {"type": "string", "enum": ["beta", "t_value"]},
            "use_unthresholded": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "metrics": {
          "type": "object",
          "properties": {
            "whole_map": {
              "type": "array",
              "items": {"type": "string", "enum": ["pearson", "cosine"]},
              "minItems": 1
            },
            "time_resolved_topography": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "method": {"type": "string", "enum": ["pearson"]}
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "inference": {
          "type": "object",
          "properties": {
            "method": {"type": "string", "enum": ["none", "sign_flip", "refit_permutation"]},
            "n_permutations": {"type": "integer", "minimum": 1},
            "random_seed": {"type": "integer"},
            "tail": {"type": "string", "enum": ["two-sided", "greater", "less"]},
            "tfce": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "e_power": {"type": "number"},
                "h_power": {"type": "number"},
                "dh": {"type": "number", "exclusiveMinimum": 0}
              },
              "additionalProperties": true
            },
            "permutation_scheme": {
              "type": "object",
              "properties": {
                "kind": {"type": "string", "enum": ["circular_shift_within_subject"]},
                "group_by": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "minItems": 1
                },
                "within_run": {"type": "boolean"},
                "random_seed": {"type": "integer"}
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "inferential_test": {"type": "object"},
        "outputs": {"type": "object"}
      },
      "additionalProperties": true
    },
    "debug": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "max_files": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
