{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "speech-rate mass-univariate config",
  "type": "object",
  "required": ["paths", "dataset", "preprocessing", "epochs", "glm", "fooof", "lmeeeg"],
  "properties": {
    "paths": {
      "type": "object",
      "required": ["out_dir"],
      "properties": {
        "out_dir": {"type": "string", "minLength": 1},
        "bids_dir": {"type": "string", "minLength": 1},
        "eeg_dir": {"type": "string", "minLength": 1},
        "annotations_dir": {"type": "string", "minLength": 1},
        "logs_dir": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "dataset": {
      "type": "object",
      "properties": {
        "tasks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "runs": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "integer"},
              {"type": "string", "minLength": 1}
            ]
          }
        },
        "missing_runs": {"type": "array"},
        "exclude": {"type": "object"}
      },
      "additionalProperties": true
    },
    "preprocessing": {"type": "object"},
    "epochs": {"type": "object"},
    "glm": {"type": "object"},
    "fooof": {"type": "object"},
    "lmeeeg": {"type": "object"},
    "debug": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "max_files": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
