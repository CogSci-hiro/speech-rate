{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "speech-rate SG0 config",
  "type": "object",
  "required": [
    "paths",
    "dataset",
    "events",
    "evoked_trf",
    "induced_trf",
    "ddc",
    "reporting"
  ],
  "properties": {
    "paths": {
      "type": "object",
      "required": [
        "out_dir"
      ],
      "properties": {
        "out_dir": {
          "type": "string",
          "minLength": 1
        },
        "bids_dir": {
          "type": "string",
          "minLength": 1
        },
        "eeg_dir": {
          "type": "string",
          "minLength": 1
        },
        "annotations_dir": {
          "type": "string",
          "minLength": 1
        },
        "logs_dir": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "dataset": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        },
        "missing_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dyad_id",
              "run"
            ],
            "properties": {
              "dyad_id": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              },
              "run": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "exclude_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dyad_id",
              "run",
              "reason"
            ],
            "properties": {
              "dyad_id": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              },
              "run": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "events": {
      "type": "object"
    },
    "evoked_trf": {
      "type": "object"
    },
    "induced_trf": {
      "type": "object"
    },
    "ddc": {
      "type": "object"
    },
    "reporting": {
      "type": "object"
    },
    "random_seed": {
      "type": "integer"
    }
  },
  "additionalProperties": true
}
