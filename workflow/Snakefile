import sys
from functools import lru_cache
from pathlib import Path

import pandas as pd
import yaml

_workflow = globals().get("workflow")
if _workflow is not None and getattr(_workflow, "basedir", None):
    WORKFLOW_DIR = Path(_workflow.basedir).resolve()
else:
    WORKFLOW_DIR = (Path.cwd() / "workflow").resolve()
PROJECT_ROOT = WORKFLOW_DIR.parent

sys.path.insert(0, str(PROJECT_ROOT / "src"))

from rate.config import load_and_validate_config
from rate.design import ModelSpecError, list_model_names
from rate.epochs.io import build_epoch_output_paths
from rate.lmeeeg.io import build_lmeeeg_model_output_paths
from rate.lmeeeg.similarity import build_similarity_output_paths
from rate.lmeeeg.targets import resolve_target_names
from rate.lmeeeg.variance_partition import (
    build_variance_partition_fit_output_paths,
    build_variance_partition_group_output_paths,
)
from rate.preprocessing.io import build_preprocessing_output_paths
from rate.util import read_parquet_dataframe

configfile: str(PROJECT_ROOT / "config" / "config.yaml")


def _load_yaml(path: str) -> dict:
    text = Path(path).read_text(encoding="utf-8")
    payload = yaml.safe_load(text) or {}
    if not isinstance(payload, dict):
        raise RuntimeError(f"{path} must contain a YAML mapping.")
    return payload


stats_config = _load_yaml(str(PROJECT_ROOT / "config" / "stats.yaml"))
viz_config = _load_yaml(str(PROJECT_ROOT / "config" / "viz.yaml"))
RESOLVED_CONFIG = load_and_validate_config(
    PROJECT_ROOT / "config" / "config.yaml",
    schema_path=PROJECT_ROOT / "config" / "schema.json",
)

if "paths" not in RESOLVED_CONFIG or "out_dir" not in (RESOLVED_CONFIG.get("paths") or {}):
    raise RuntimeError("config/config.yaml must define paths.out_dir")

OUT_DIR = str((RESOLVED_CONFIG.get("paths") or {})["out_dir"])
def _safe_list_model_names(config, *, section: str) -> tuple[str, ...]:
    try:
        return tuple(list_model_names(config, section=section))
    except ModelSpecError:
        return ()


LMEEEG_MODEL_NAMES = _safe_list_model_names(RESOLVED_CONFIG, section="lmeeeg")
BEHAVIOURAL_RESIDUALS_DIR = f"{OUT_DIR}/stats/behavioural_residuals"
BEHAVIOURAL_RESIDUALS_OUTPUT = f"{BEHAVIOURAL_RESIDUALS_DIR}/trialwise_residuals.csv"
BEHAVIOURAL_RANDOM_EFFECTS_OUTPUT = f"{BEHAVIOURAL_RESIDUALS_DIR}/random_effects.csv"
BEHAVIOURAL_SUBJECT_SLOPES_OUTPUT = f"{BEHAVIOURAL_RESIDUALS_DIR}/subject_slopes.csv"
BEHAVIOURAL_MODEL_SUMMARY_CSV_OUTPUT = f"{BEHAVIOURAL_RESIDUALS_DIR}/behavioural_model_summary.csv"
BEHAVIOURAL_MODEL_SUMMARY_TXT_OUTPUT = f"{BEHAVIOURAL_RESIDUALS_DIR}/behavioural_model_summary.txt"
R_ANALYSIS_MODEL_SUMMARY_TXT_OUTPUT = f"{OUT_DIR}/stats/r_analysis/analysis_model_summaries.txt"


def _dataset_index_checkpoint_path() -> str:
    return str(checkpoints.dataset_index.get().output.index)


@lru_cache(maxsize=None)
def _dataset_index_records(index_path: str) -> tuple[dict, ...]:
    dataframe = read_parquet_dataframe(Path(index_path))
    return tuple(dataframe.to_dict(orient="records"))


def _ok_run_rows(index_path: str, *, required_fields: tuple[str, ...]) -> tuple[dict, ...]:
    rows: list[dict] = []
    for row in _dataset_index_records(index_path):
        if str(row.get("status", "")).lower() != "ok":
            continue
        if any(pd.isna(row.get(field)) for field in required_fields):
            continue
        rows.append(row)
    return tuple(rows)


@lru_cache(maxsize=None)
def _preprocessing_run_map(index_path: str) -> dict[tuple[str, str, str], dict]:
    rows = _ok_run_rows(
        index_path,
        required_fields=("dyad_id", "subject_id", "task", "run", "raw_eeg_path"),
    )
    return {
        (str(row["subject_id"]), str(row["task"]), str(row["run"])): row
        for row in rows
    }


@lru_cache(maxsize=None)
def _epochs_run_map(index_path: str) -> dict[tuple[str, str, str], dict]:
    rows = _ok_run_rows(
        index_path,
        required_fields=("dyad_id", "subject_id", "task", "run", "eeg_path"),
    )
    return {
        (str(row["subject_id"]), str(row["task"]), str(row["run"])): row
        for row in rows
    }


@lru_cache(maxsize=None)
def _epochs_subject_map(index_path: str) -> dict[str, dict]:
    subject_rows: dict[str, dict] = {}
    for row in _epochs_run_map(index_path).values():
        subject_id = str(row["subject_id"])
        subject_rows.setdefault(subject_id, row)
    return subject_rows


def preprocessing_row(wildcards):
    index_path = _dataset_index_checkpoint_path()
    key = (str(wildcards.subject_id), str(wildcards.task), str(wildcards.run))
    return _preprocessing_run_map(index_path)[key]


def preprocessing_paths(wildcards):
    return build_preprocessing_output_paths(RESOLVED_CONFIG, preprocessing_row(wildcards))


def preprocessing_stage_inputs(wildcards):
    index_path = _dataset_index_checkpoint_path()
    return [
        str(build_preprocessing_output_paths(RESOLVED_CONFIG, row).summary_output_path)
        for row in _preprocessing_run_map(index_path).values()
    ]


def epochs_row(wildcards):
    index_path = _dataset_index_checkpoint_path()
    key = (str(wildcards.subject_id), str(wildcards.task), str(wildcards.run))
    return _epochs_run_map(index_path)[key]


def epoch_paths(wildcards):
    return build_epoch_output_paths(RESOLVED_CONFIG, epochs_row(wildcards))


def epochs_stage_inputs(wildcards):
    index_path = _dataset_index_checkpoint_path()
    return [
        str(build_epoch_output_paths(RESOLVED_CONFIG, row).summary_output_path)
        for row in _epochs_subject_map(index_path).values()
    ]


def margin_epoch_paths(wildcards):
    return build_epoch_output_paths(RESOLVED_CONFIG, epochs_row(wildcards), epochs_section="margin_epochs")


def margin_epoch_subject_paths(wildcards):
    index_path = _dataset_index_checkpoint_path()
    row = _epochs_subject_map(index_path)[str(wildcards.subject_id)]
    return build_epoch_output_paths(RESOLVED_CONFIG, row, epochs_section="margin_epochs")


def margin_epochs_stage_inputs(wildcards):
    index_path = _dataset_index_checkpoint_path()
    return [
        str(build_epoch_output_paths(RESOLVED_CONFIG, row, epochs_section="margin_epochs").summary_output_path)
        for row in _epochs_subject_map(index_path).values()
    ]


def epoch_subject_preprocessing_inputs(wildcards):
    index_path = _dataset_index_checkpoint_path()
    subject_id = str(wildcards.subject_id)
    rows = [
        row
        for row in _epochs_run_map(index_path).values()
        if str(row["subject_id"]) == subject_id
    ]
    inputs: list[str] = []
    for row in rows:
        paths = build_preprocessing_output_paths(RESOLVED_CONFIG, row)
        inputs.append(str(paths.eeg_output_path))
    return inputs


def lmeeeg_stage_inputs(wildcards):
    return [
        str(build_lmeeeg_model_output_paths(RESOLVED_CONFIG, model_name=model_name).summary_output_path)
        for model_name in LMEEEG_MODEL_NAMES
    ]


def _safe_target_names(config, *, section: str) -> tuple[str, ...]:
    try:
        return tuple(target for target in resolve_target_names(config, config_section=section) if target is not None)
    except ValueError:
        return ()

def lmeeeg_variance_partition_stage_inputs(wildcards):
    return [str(build_variance_partition_fit_output_paths(RESOLVED_CONFIG).summary_output_path)]


def similarity_stage_inputs(wildcards):
    return [str(build_similarity_output_paths(RESOLVED_CONFIG).summary_output_path)]

